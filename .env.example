# ─── Web Push (VAPID) Anahtarları ───────────────────────────────────────────
# Oluşturmak için: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your@email.com

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Seçenek 1: Upstash Console'dan aldığınız değerler (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Seçenek 2: Vercel KV entegrasyonu (Vercel Dashboard → Storage → Connect)
# Vercel otomatik olarak bu değişkenleri ekler; elle girmenize gerek kalmaz.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here

# ─── Güvenlik ────────────────────────────────────────────────────────────────
# Cron Job güvenlik anahtarı (isteğe bağlı, üretimde önerilir)
CRON_SECRET=your_random_secret_here
